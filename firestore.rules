rules_version = '2';

// MALACONDA: browsers may NEVER read or write Firestore directly.
// Only the backend (service account, Admin SDK) accesses the database;
// the Admin SDK is not affected by these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
