# =============================================================
# MALACONDA — Environment variables (TEMPLATE)
#
# HOW TO USE
#   Local:      copy this file to `.env` and fill in TEST values.
#               `npm run dev` loads it automatically.
#   Hostinger:  set the same names in hPanel → Node.js app →
#               Environment variables. Never upload a .env file.
#
# RULES
#   - This file contains NAMES only, never real values.
#   - `.env` is git-ignored. Never commit real keys.
#   - Development uses Stripe TEST keys only (sk_test_…). A live key is
#     refused unless ALLOW_LIVE_PAYMENTS=true.
#
# The app checks these at startup: missing REQUIRED values stop it with a
# clear message; missing OPTIONAL ones switch the feature off with a warning.
# =============================================================

# ---------- App ----------
# development | production
NODE_ENV=development
# Hostinger sets PORT automatically; 3000 is the local default.
PORT=3000
# Public URL of the site (Stripe return pages, emails, allowed origin).
# Local: http://localhost:3000   Production: https://your-domain
PUBLIC_BASE_URL=http://localhost:3000
# Extra allowed browser origins, comma-separated (normally empty).
CORS_ALLOWED_ORIGINS=
# REQUIRED. Random secret, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ---------- Stripe (TEST MODE during development) ----------
# REQUIRED. Stripe Dashboard → Developers → API keys (test mode): sk_test_…
STRIPE_SECRET_KEY=
# REQUIRED. Local: printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`
#           Production: Dashboard → Developers → Webhooks → endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=
# Only for the real launch, after owner approval:
ALLOW_LIVE_PAYMENTS=false

# ---------- Firebase / Firestore (database) ----------
# REQUIRED in production. Firebase console → Project settings → Service accounts
# → Generate new private key → convert the JSON file to Base64:
#   base64 -w0 service-account.json        (macOS: base64 -i service-account.json)
# The same service account is used for Google Sheets.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Local development without credentials: run the Firestore emulator and set
#   FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
#   FIREBASE_PROJECT_ID=demo-malaconda
FIRESTORE_EMULATOR_HOST=
FIREBASE_PROJECT_ID=
# Firestore connection type. Leave empty (REST). Set to false to use gRPC.
FIRESTORE_PREFER_REST=

# ---------- B2C shipping (Switzerland only) ----------
# OPTIONAL until decided: B2C checkout stays CLOSED while empty.
# Amount in cents, VAT incl. (e.g. 900 = CHF 9.00).
SHIPPING_CH_CENTS=
# Optional free-shipping threshold in cents (after discount). Empty = never free.
FREE_SHIPPING_FROM_CENTS=

# ---------- B2B partner pre-orders ----------
# Payment options offered to partners: stripe, invoice, or both.
PARTNER_PAYMENT_MODES=stripe,invoice

# ---------- Google Sheets reporting (OPTIONAL) ----------
# ID from the spreadsheet URL: https://docs.google.com/spreadsheets/d/<ID>/edit
# Share the spreadsheet (Editor) with the service account email.
GOOGLE_SHEETS_SPREADSHEET_ID=

# ---------- Email (SMTP, OPTIONAL: without it emails are only logged) ----------
SMTP_HOST=
SMTP_PORT=465
# true for port 465, false for 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to customers, e.g. "Malaconda <orders@your-domain>"
EMAIL_FROM=
# Team address for new orders, invoices to send, forms
EMAIL_TEAM_TO=

# ---------- Admin ----------
# Emails allowed to sign in to the admin API, comma-separated.
ADMIN_EMAILS=
