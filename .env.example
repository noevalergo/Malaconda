# =============================================================
# MALACONDA — Environment variables (TEMPLATE)
#
# HOW TO USE
#   Local:      copy this file to `.env` and fill in TEST values.
#   Hostinger:  set the same names in hPanel → Node.js app →
#               Environment variables. Never upload a .env file.
#
# RULES
#   - This file contains NAMES only, never real values.
#   - `.env` is git-ignored. Never commit real keys.
#   - Development uses Stripe TEST keys only (sk_test_ / whsec_ from test mode).
#
# STATUS: provisional. The final list is fixed in Phase 2
# (architecture) and may change before implementation.
# =============================================================

# ---------- App ----------
# development | production
NODE_ENV=development
# Hostinger injects PORT automatically; 3000 is the local default.
PORT=3000
# Public URL of the site, used for Stripe success/cancel redirects.
# Local: http://localhost:3000   Production: https://your-domain
PUBLIC_BASE_URL=http://localhost:3000

# ---------- Stripe (TEST MODE during development) ----------
# Secret key: Stripe Dashboard → Developers → API keys (test mode)
STRIPE_SECRET_KEY=
# Webhook signing secret: from `stripe listen` locally, or from the
# webhook endpoint in the Stripe Dashboard in production.
STRIPE_WEBHOOK_SECRET=
# Price IDs of the two products (Stripe → Product catalogue)
STRIPE_PRICE_ID_PRODUCT_1=
STRIPE_PRICE_ID_PRODUCT_2=

# ---------- B2B partner pre-orders ----------
# stripe  = customer pays the 20% downpayment via Stripe Checkout
# invoice = order recorded as PENDING_INVOICE, admin sends invoice manually
PARTNER_PAYMENT_MODE=stripe

# ---------- Google Sheets ----------
# ID of the spreadsheet (the long string in its URL)
GOOGLE_SHEETS_SPREADSHEET_ID=
# Service account email (…@….iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Service account private key. Paste on one line with \n for line breaks.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ---------- Email (SMTP — provider can be changed here) ----------
SMTP_HOST=
SMTP_PORT=465
# true for port 465, false for 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to customers, e.g. "Malaconda <orders@your-domain>"
EMAIL_FROM=
# Internal address that receives business notifications
EMAIL_ADMIN_TO=

# ---------- Security ----------
# Comma-separated list of allowed browser origins for the API
CORS_ALLOWED_ORIGINS=http://localhost:3000
